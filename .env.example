# =================================================================
# LLM Provider Configuration
# The system automatically detects which API key you provide!
# =================================================================

# --- 1. OLLAMA (Local or Remote / Cloud VPS / Tunnel) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=phi3:mini
# OLLAMA_API_KEY=               # Optional: If your remote Ollama is protected with an API key / Bearer token

# --- 2. GROQ (100% Free & Fast) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- 3. OPENAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- 4. DEEPSEEK ---
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# --- 5. OPENROUTER ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- 6. GOOGLE GEMINI ---
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# --- 7. ANY CUSTOM OPENAI-COMPATIBLE PROVIDER ---
# LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://api.your-provider.com/v1
# LLM_MODEL=your-model-name
